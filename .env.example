# ============================================================================
# GRIDPOINT Environment Configuration Example
# Copy this file to .env and provide your API keys.
# ============================================================================

# Option 1: Anthropic API Key (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Option 2: Google Gemini API Key (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash


