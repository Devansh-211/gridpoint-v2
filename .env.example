# ============================================================================
# GRIDPOINT Environment Configuration Example
# Copy this file to .env and provide your API keys.
# ============================================================================

# Anthropic API Key (Required for AI conversational setup, grounded explainer, and synthetic generation)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Claude model selection (defaults to claude-3-5-sonnet-20241022)
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
